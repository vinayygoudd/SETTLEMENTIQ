# SettlementIQ Environment Configuration Example
# Copy this file to .env and populate local values. Never commit real secrets.

SETTLEMENTIQ_ENV=development
SETTLEMENTIQ_RANDOM_SEED=42
SETTLEMENTIQ_DEFAULT_TXN_COUNT=10000
SETTLEMENTIQ_REPORTING_DATE=2026-10-25
SETTLEMENTIQ_TOLERANCE_INR=1.00
SETTLEMENTIQ_SLA_BUSINESS_DAYS=2

# PostgreSQL Connection Settings (Authoritative Production/Local DB)
SETTLEMENTIQ_PG_HOST=localhost
SETTLEMENTIQ_PG_PORT=5432
SETTLEMENTIQ_PG_DB=settlementiq
SETTLEMENTIQ_PG_USER=settlementiq_role
SETTLEMENTIQ_PG_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD

# Local Execution Fallback (Relational SQLite Mirror when PostgreSQL server is offline)
SETTLEMENTIQ_SQLITE_PATH=data/processed/settlementiq_authoritative.sqlite
